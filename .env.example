# Conexión a Neon (cadena "pooled")
DATABASE_URL=
# Firma de las sesiones. Genera una con: openssl rand -base64 32
AUTH_SECRET=
# Usuario master inicial. Se crea solo la primera vez que alguien ingresa y no existe ningún usuario.
MASTER_EMAIL=
MASTER_PASSWORD=
# Vercel Blob (lo crea Vercel al conectar el almacenamiento)
BLOB_READ_WRITE_TOKEN=
# Opcional: avisos por correo al comprador (Resend). Sin estas dos, no se envían correos.
RESEND_API_KEY=
CORREO_REMITENTE=
# Opcional: dirección pública del sitio para los enlaces de los correos (https://tudominio.com)
SITIO_URL=
# Protege la tarea diaria de Vercel (mensualidades y recordatorios)
CRON_SECRET=
